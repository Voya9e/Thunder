#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
EXTRA_COMMANDS="install"
EXTRA_HELP="\tinstall\tInstall/initialize the upstream Thunder core"

THUNDER=/usr/bin/thunder
INSTALL_CONFIG=/etc/.thunder
CORE_DIR=/var/packages/pan-xunlei-com/target
INSTALL_MARKER=$CORE_DIR/var
PIDFILE=/var/run/thunder-luci.pid
INSTALL_LOCK=/var/lock/thunder-install.lock

core_launcher() {
	case "$(uname -m)" in
		aarch64) echo "$CORE_DIR/xunlei-pan-cli-launcher.arm64" ;;
		*) echo "$CORE_DIR/xunlei-pan-cli-launcher.amd64" ;;
	esac
}

core_ready() {
	[ -x "$(core_launcher)" ] &&	[ -x "$CORE_DIR/xunlei-pan-cli" ] &&	[ -x "$CORE_DIR/xunlei-pan-cli-web" ]
}

valid_path() {
	case "$1" in
		/*) case "$1" in *'
'*|*'\r'*) return 1 ;; esac ;;
		*) return 1 ;;
	esac
	case "$1" in *'='*) return 1 ;; esac
	cr="$(printf '\r')"
	case "$1" in *"$cr"*) return 1 ;; esac
	return 0
}

write_install_config() {
	uid="$1"
	gid="$2"
	config_path="$3"
	download_path="$4"
	mount_path="$5"
	case "$uid" in ''|*[!0-9]*) return 1 ;; esac
	case "$gid" in ''|*[!0-9]*) return 1 ;; esac
	valid_path "$config_path" || return 1
	valid_path "$download_path" || return 1
	valid_path "$mount_path" || return 1
	tmp="$(mktemp "${INSTALL_CONFIG}.XXXXXX")" || return 1
	{
		printf 'uid=%s\n' "$uid"
		printf 'gid=%s\n' "$gid"
		printf 'config_path=%s\n' "$config_path"
		printf 'download_path=%s\n' "$download_path"
		printf 'mount_bind_download_path=%s\n' "$mount_path"
	} > "$tmp" || { rm -f "$tmp"; return 1; }
	chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
	mv "$tmp" "$INSTALL_CONFIG" || { rm -f "$tmp"; return 1; }
}

start_service() {
	local uid gid config_path download_path mount_path bind auth_password
	config_load thunder
	config_get uid main uid 0
	config_get gid main gid 0
	config_get config_path main config_path /opt/thunder
	config_get download_path main download_path /opt/thunder/downloads
	config_get mount_path main mount_bind_download_path /thunder
	config_get bind main bind 0.0.0.0:5055
	config_get auth_password main auth_password ''

	[ -x "$THUNDER" ] || { logger -t thunder "Missing $THUNDER"; return 1; }
	core_ready || { logger -t thunder "Core not initialized; use Services > Thunder > Settings to initialize it"; return 1; }
	if [ -z "$auth_password" ]; then
		case "$bind" in
			127.0.0.1:*|'[::1]':*) ;;
			*) logger -t thunder "Set a panel password before listening beyond localhost"; return 1 ;;
		esac
	fi
	write_install_config "$uid" "$gid" "$config_path" "$download_path" "$mount_path" || {
		logger -t thunder "Invalid UID/GID or directory setting"; return 1;
	}
	mkdir -p "$config_path" "$download_path" "$mount_path" || return 1
	chown "$uid:$gid" "$config_path" "$download_path" "$mount_path" 2>/dev/null || return 1

	procd_open_instance
	procd_set_param command /usr/libexec/thunder-run "$THUNDER" run
	procd_set_param env "THUNDER_BIND=$bind"
	[ -z "$auth_password" ] || procd_set_param env "THUNDER_AUTH_PASS=$auth_password"
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

install() {
	local uid gid config_path download_path mount_path result partial
	if ! mkdir "$INSTALL_LOCK" 2>/dev/null; then
		echo "Core initialization is already running." >&2
		return 1
	fi
	trap 'rmdir "$INSTALL_LOCK" 2>/dev/null' EXIT HUP INT TERM
	config_load thunder
	config_get uid main uid 0
	config_get gid main gid 0
	config_get config_path main config_path /opt/thunder
	config_get download_path main download_path /opt/thunder/downloads
	config_get mount_path main mount_bind_download_path /thunder
	[ -x "$THUNDER" ] || { echo "Missing $THUNDER" >&2; return 1; }
	write_install_config "$uid" "$gid" "$config_path" "$download_path" "$mount_path" || {
		echo "Invalid UID/GID or directory setting" >&2; return 1;
	}
	# The upstream installer creates its var directory before downloading the SPK
	# and treats that directory alone as proof of a completed install. Preserve a
	# partial marker so a failed first attempt can be retried safely.
	if [ -d "$INSTALL_MARKER" ] && ! core_ready; then
		partial="$CORE_DIR/var.partial.$$"
		mv "$INSTALL_MARKER" "$partial" || { echo "Cannot recover partial core install" >&2; return 1; }
		echo "Moved incomplete core state to $partial; retrying installation."
	fi
	"$THUNDER" install -U "$uid" -G "$gid" -c "$config_path" -d "$download_path" -m "$mount_path"
	result=$?
	if [ "$result" -eq 0 ] && ! core_ready; then
		echo "Core initialization returned success, but required ARM/Linux core files are missing." >&2
		result=1
	fi
	trap - EXIT HUP INT TERM
	rmdir "$INSTALL_LOCK" 2>/dev/null
	return "$result"
}

stop_service() {
	rm -f "$PIDFILE"
}

service_running() {
	[ -r "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE" 2>/dev/null)"
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	kill -0 "$pid" 2>/dev/null
}

status() {
	if service_running; then
		echo "thunder is running (pid $(cat "$PIDFILE"))"
		return 0
	fi
	echo "thunder is stopped"
	return 1
}

